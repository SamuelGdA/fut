# Modo de imagens (GDD seção 31).
#   gerado = só a arte desenhada pelo jogo; bandeiras continuam reais (padrão)
#   real   = escudos, logos de liga e troféus reais, com a arte desenhada
#            só onde falta imagem
VITE_ASSETS=gerado

# Endereço público do jogo, impresso no rodapé do pôster (GDD 29.1).
# Sem ele, o pôster mostra o endereço de onde o jogo está sendo servido.
# VITE_SITE_URL=craque.example.com
