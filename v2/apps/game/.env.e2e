# Build da suíte ponta a ponta (pnpm e2e usa --mode e2e). Versionado: nada aqui
# é real. Este arquivo vence o .env.local de quem roda os testes, então a suíte
# nunca toca o Supabase de verdade nem o Google.
VITE_ASSETS=real
# Um projeto Supabase que não existe: a suíte responde às chamadas dele (e2e/conta.ts).
VITE_SUPABASE_URL=https://e2e-futeiros.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e2e_somente_testes
# Um ID de medição falso: liga o aviso de cookies; o script do Google é interceptado.
VITE_GA_MEASUREMENT_ID=G-E2ETESTE00
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_PERFIL=
VITE_ADSENSE_SLOT_RESUMO=
VITE_ADSENSE_SLOT_CONQUISTAS=
VITE_CONTACT_EMAIL=contato@exemplo.com
VITE_SITE_URL=
