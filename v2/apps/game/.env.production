# Valores públicos do site no ar (D121). Vão no build de produção, inclusive no
# build automático da Cloudflare. Nada secreto aqui: o endereço do Supabase e a
# chave publicável ficam nas variáveis do build, no painel da Cloudflare.
VITE_SITE_URL=https://futeiro.com
VITE_CONTACT_EMAIL=contact@futeiro.com
# Modos que o site no ar mostra como "Em breve" e não abre (D124). As telas
# deles nem entram no build. No computador (pnpm dev) e na suíte, vazio.
VITE_MODOS_BLOQUEADOS=tecnico
# ID do cliente OAuth do Google (D123): público, vai na página de login.
VITE_GOOGLE_CLIENT_ID=659347225726-djl6so73pjpko4vqmpkcd2ofc5klmah8.apps.googleusercontent.com
