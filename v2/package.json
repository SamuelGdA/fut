{
  "name": "craque-v2",
  "version": "2.0.0",
  "private": true,
  "description": "CRAQUE v2: simulador de carreira de futebol jogado por decisoes",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @craque/game dev",
    "start": "pnpm --filter @craque/game dev:open",
    "build": "pnpm --filter @craque/game build",
    "preview": "pnpm --filter @craque/game preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm balance:check && pnpm build",
    "e2e": "pnpm --filter @craque/game e2e",
    "notas:exportar": "node packages/world/scripts/notas.mjs exportar",
    "notas:importar": "node packages/world/scripts/notas.mjs importar",
    "elencos:coletar": "node packages/world/scripts/elencos/coletar-efootball.mjs",
    "elencos:montar": "node packages/world/scripts/elencos/montar.mjs",
    "balance": "pnpm --filter @craque/balance balance",
    "balance:check": "pnpm --filter @craque/balance balance --carreiras 2500 --check --sem-arquivo",
    "balance:tecnico": "pnpm --filter @craque/balance tecnico",
    "balance:tecnico:check": "pnpm --filter @craque/balance tecnico --carreiras 8 --temporadas 12 --check --sem-arquivo",
    "balance:recordes": "pnpm --filter @craque/balance recordes",
    "desafio:calibrar": "pnpm --filter @craque/balance desafio:calibrar",
    "carreira": "pnpm --silent --filter @craque/terminal carreira"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
