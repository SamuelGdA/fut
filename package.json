{
  "name": "craque",
  "version": "0.0.0",
  "private": true,
  "description": "CRAQUE: simulador de carreira de futebol",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "turbo run typecheck lint test",
    "balance": "pnpm --filter @craque/balance run balance",
    "balance:capture": "pnpm --filter @craque/balance run capture",
    "balance:check": "pnpm --filter @craque/balance run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
